# ------------------------------------------------------------------
# Hábito Simple — variables de entorno / secrets
# Copia lo que necesites a tu lanzador local (run_test.ps1) o cárgalo
# como Secrets/Variables en GitHub → Settings → Secrets and variables → Actions.
# NO subas este archivo con valores reales.
# ------------------------------------------------------------------

# --- Gemini (guion + fondo IA) ---
GEMINI_API_KEY=pega_tu_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
IMAGE_BACKEND=gemini
IMAGE_MODEL=

# --- Meta (Instagram + Facebook) ---
META_ACCESS_TOKEN=token_de_pagina_system_user
IG_USER_ID=
FB_PAGE_ID=
GRAPH_VERSION=v23.0

# --- B-roll / fondos (gratis) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Telegram (aprobación de borradores) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube Shorts ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=public

# --- Identidad de marca / contenido ---
NICHE=salud y bienestar
WATERMARK_TEXT=@habitosimplemx
KICKER_TEXT=HÁBITO SIMPLE
TTS_VOICE=es-MX-DaliaNeural
DISCLAIMER_TEXT=Info general · No sustituye a tu médico
DISCLAIMER_LARGO=ℹ️ Información general y educativa, no reemplaza a tu médico.

# --- Solo lo pone GitHub Actions automáticamente ---
# GITHUB_TOKEN=  (lo inyecta Actions)
# GITHUB_REPOSITORY=  (lo inyecta Actions)
