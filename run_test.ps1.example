# Prueba LOCAL del REEL (video). Copia este archivo como run_test.ps1 y pon tu API key.
# run_test.ps1 está en .gitignore para que NO se suba con la clave.
# Uso: .\run_test.ps1
$ErrorActionPreference = "Stop"
Set-Location -Path $PSScriptRoot
& .\.venv\Scripts\Activate.ps1

# Fuente segura en Windows (FFmpeg/Pillow buscan un .ttf real)
$env:IMG_FONT_FILE = "C:\Windows\Fonts\arialbd.ttf"

# --- Identidad de marca ---
$env:NICHE          = "salud y bienestar"
$env:WATERMARK_TEXT = "@habitosimplemx"
$env:KICKER_TEXT    = "HÁBITO SIMPLE"
$env:TTS_VOICE      = "es-MX-DaliaNeural"
$env:DISCLAIMER_TEXT = "Info general · No sustituye a tu médico"

# --- Gemini (guion + fondo IA) ---
$env:GEMINI_API_KEY = "PEGA_TU_API_KEY"
$env:GEMINI_MODEL   = "gemini-3.6-flash"

# --- b-roll opcional (déjalo vacío para usar el degradado verde) ---
# $env:PEXELS_API_KEY = ""

python test_local.py
